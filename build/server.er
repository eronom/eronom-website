import "./server/api/routes.er"

import { router } from "std/http"

let app = router()

app.get("/", (c) => {
  let template = render("app/pages/index.html", c.req.params)
  return c.html(template)
})

app.get("/api", (c) => {
  let template = render("app/pages/api.html", c.req.params)
  return c.html(template)
})

app.get("/benchmarks", (c) => {
  let template = render("app/pages/benchmarks.html", c.req.params)
  return c.html(template)
})

app.get("/docs", (c) => {
  let template = render("app/pages/docs.html", c.req.params)
  return c.html(template)
})

app.get("/guides", (c) => {
  let template = render("app/pages/guides.html", c.req.params)
  return c.html(template)
})

