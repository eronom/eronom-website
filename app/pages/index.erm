<script>
    import Header from "../components/Header.erm";
    import Footer from "../components/Footer.erm";

    // Interactive Demo Signals
    let count = useState(5);
    let double = useState(() => count * 2);
    let demoTab = useState('component');
    let items = useState(["Reactive Signal", "Rust HMR Engine", "Zero VDOM", "Server API"]);
    let newItemText = useState('');
    let activeTheme = useState('dark');

    function addItem() {
        if (newItemText.value.trim()) {
            items.push(newItemText.value.trim());
            newItemText.value = '';
        }
    }

    function removeItem(index) {
        items.splice(index, 1);
    }
</script>

