<script>
    import Header from "../components/Header.erm";
    import Footer from "../components/Footer.erm";

    let metricTab = useState('throughput');
</script>

<style>
    .benchmarks-container {
        padding: 40px 0 80px;
    }

    .bench-header {
        text-align: center;
        max-width: 700px;
        margin: 0 auto 40px;
    }

    .tab-select-group {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 40px;
    }

    .bench-tab-btn {
        padding: 10px 20px;
        border-radius: 10px;
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        color: #94a3b8;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .bench-tab-btn.active {
        background: rgba(0, 242, 254, 0.15);
        color: #00f2fe;
        border-color: rgba(0, 242, 254, 0.4);
    }

    .metric-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
        margin-bottom: 48px;
    }

    .metric-stat-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: 18px;
        padding: 24px;
        text-align: center;
    }

    .stat-number {
        font-size: 2.8rem;
        font-weight: 800;
        color: #00f2fe;
        margin-bottom: 4px;
    }

    .stat-title {
        color: #94a3b8;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .chart-box {
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 36px;
    }

    .chart-row {
        margin-bottom: 24px;
    }

    .chart-label {
        display: flex;
        justify-content: space-between;
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 8px;
    }

    .chart-bar-bg {
        height: 14px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 7px;
        overflow: hidden;
    }

    .chart-bar-fill {
        height: 100%;
        border-radius: 7px;
        transition: width 0.8s ease-out;
    }
</style>

<Header />

<main class="content-area benchmarks-container">
    <div class="container">
        <div class="bench-header">
            <span class="badge badge-green" style="margin-bottom: 12px;">Verified TechEmpower Specs</span>
            <h1 style="font-size: 2.8rem; font-weight: 800; color: #ffffff; margin-bottom: 12px;">Performance Benchmarks</h1>
            <p style="color: #94a3b8; font-size: 1rem;">
                Empirical speed measurements comparing Eronom's Rust core engine against leading JavaScript web frameworks.
            </p>
        </div>

        <!-- Metric Stat Cards -->
        <div class="metric-card-grid">
            <div class="metric-stat-card">
                <div class="stat-number">85.4k</div>
                <div class="stat-title">Requests / Second</div>
            </div>

            <div class="metric-stat-card">
                <div class="stat-number" style="color: #9d4edd;">0.18ms</div>
                <div class="stat-title">Cold Start Time</div>
            </div>

            <div class="metric-stat-card">
                <div class="stat-number" style="color: #10b981;">14.2 MB</div>
                <div class="stat-title">Memory Footprint</div>
            </div>
        </div>

        <!-- Metric Selector Tabs -->
        <div class="tab-select-group">
            <button class={metricTab === 'throughput' ? 'bench-tab-btn active' : 'bench-tab-btn'} onClick={() => { metricTab = 'throughput'; }}>
                HTTP Throughput (req/s)
            </button>
            <button class={metricTab === 'memory' ? 'bench-tab-btn active' : 'bench-tab-btn'} onClick={() => { metricTab = 'memory'; }}>
                RAM Usage (MB)
            </button>
            <button class={metricTab === 'hmr' ? 'bench-tab-btn active' : 'bench-tab-btn'} onClick={() => { metricTab = 'hmr'; }}>
                HMR Latency (ms)
            </button>
        </div>

        <!-- Visual Bar Chart -->
        <div class="chart-box">
            if metricTab === 'throughput' {
                <div>
                    <h3 style="color: #ffffff; font-size: 1.2rem; margin-bottom: 24px;">HTTP Requests Per Second (Higher is better)</h3>
                    
                    <div class="chart-row">
                        <div class="chart-label">
                            <span style="color: #00f2fe;">⚡ Eronom Framework</span>
                            <strong style="color: #00f2fe;">85,420 req/s</strong>
                        </div>
                        <div class="chart-bar-bg">
                            <div class="chart-bar-fill" style="width: 95%; background: linear-gradient(90deg, #00f2fe, #4facfe);"></div>
                        </div>
                    </div>

                    <div class="chart-row">
                        <div class="chart-label">
                            <span>Bun.js HTTP Server</span>
                            <span>62,100 req/s</span>
                        </div>
                        <div class="chart-bar-bg">
                            <div class="chart-bar-fill" style="width: 70%; background: rgba(255,255,255,0.25);"></div>
                        </div>
                    </div>

                    <div class="chart-row">
                        <div class="chart-label">
                            <span>Fastify (Node.js)</span>
                            <span>31,500 req/s</span>
                        </div>
                        <div class="chart-bar-bg">
                            <div class="chart-bar-fill" style="width: 35%; background: rgba(255,255,255,0.15);"></div>
                        </div>
                    </div>

                    <div class="chart-row">
                        <div class="chart-label">
                            <span>Next.js App Router</span>
                            <span>12,400 req/s</span>
                        </div>
                        <div class="chart-bar-bg">
                            <div class="chart-bar-fill" style="width: 14%; background: rgba(255,255,255,0.1);"></div>
                        </div>
                    </div>
                </div>
            } else if metricTab === 'memory' {
                <div>
                    <h3 style="color: #ffffff; font-size: 1.2rem; margin-bottom: 24px;">RAM Footprint at Idle (Lower is better)</h3>

                    <div class="chart-row">
                        <div class="chart-label">
                            <span style="color: #10b981;">⚡ Eronom Engine</span>
                            <strong style="color: #10b981;">14.2 MB</strong>
                        </div>
                        <div class="chart-bar-bg">
                            <div class="chart-bar-fill" style="width: 10%; background: #10b981;"></div>
                        </div>
                    </div>

                    <div class="chart-row">
                        <div class="chart-label">
                            <span>Deno HTTP</span>
                            <span>38.0 MB</span>
                        </div>
                        <div class="chart-bar-bg">
                            <div class="chart-bar-fill" style="width: 26%; background: rgba(255,255,255,0.25);"></div>
                        </div>
                    </div>

                    <div class="chart-row">
                        <div class="chart-label">
                            <span>Next.js (Node runtime)</span>
                            <span>148.5 MB</span>
                        </div>
                        <div class="chart-bar-bg">
                            <div class="chart-bar-fill" style="width: 90%; background: rgba(255,255,255,0.15);"></div>
                        </div>
                    </div>
                </div>
            } else {
                <div>
                    <h3 style="color: #ffffff; font-size: 1.2rem; margin-bottom: 24px;">Hot Module Replacement Update Latency (Lower is better)</h3>

                    <div class="chart-row">
                        <div class="chart-label">
                            <span style="color: #9d4edd;">⚡ Eronom IPC Engine</span>
                            <strong style="color: #9d4edd;">0.18 ms</strong>
                        </div>
                        <div class="chart-bar-bg">
                            <div class="chart-bar-fill" style="width: 5%; background: #9d4edd;"></div>
                        </div>
                    </div>

                    <div class="chart-row">
                        <div class="chart-label">
                            <span>Vite HMR</span>
                            <span>14.5 ms</span>
                        </div>
                        <div class="chart-bar-bg">
                            <div class="chart-bar-fill" style="width: 40%; background: rgba(255,255,255,0.25);"></div>
                        </div>
                    </div>

                    <div class="chart-row">
                        <div class="chart-label">
                            <span>Turbopack (Next.js)</span>
                            <span>32.0 ms</span>
                        </div>
                        <div class="chart-bar-bg">
                            <div class="chart-bar-fill" style="width: 75%; background: rgba(255,255,255,0.15);"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</main>

<Footer />
