<script>
    let isMobileMenuOpen = useState(false);
    let isSearchOpen = useState(false);
    let searchQuery = useState('');

    function openSearch() {
        isSearchOpen = true;
    }
    function closeSearch() {
        isSearchOpen = false;
    }
    function toggleMobileMenu() {
        isMobileMenuOpen = !isMobileMenuOpen;
    }
</script>

<style>
    .header-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(9, 10, 15, 0.82);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        height: 64px;
        display: flex;
        align-items: center;
    }

    .nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .brand-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #ffffff;
        text-decoration: none;
    }

    .logo-icon {
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #00f2fe, #9d4edd);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        box-shadow: 0 0 15px rgba(0, 242, 254, 0.4);
    }

    .brand-logo-img {
        height: 32px;
        width: auto;
        object-fit: contain;
        border-radius: 6px;
        filter: drop-shadow(0 0 8px rgba(0, 242, 254, 0.3));
        transition: transform 0.2s ease;
    }

    .brand-logo:hover .brand-logo-img {
        transform: scale(1.05);
    }

    .version-pill {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 12px;
        background: rgba(0, 242, 254, 0.12);
        color: #00f2fe;
        border: 1px solid rgba(0, 242, 254, 0.3);
    }

    .nav-menu {
        display: flex;
        align-items: center;
        gap: 24px;
        list-style: none;
    }

    .nav-link {
        font-size: 0.9rem;
        font-weight: 500;
        color: #94a3b8;
        transition: color 0.2s ease;
        text-decoration: none;
    }
    .nav-link:hover {
        color: #ffffff;
    }

    .search-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        padding: 8px 14px;
        color: #64748b;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .search-btn:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(0, 242, 254, 0.3);
        color: #94a3b8;
    }

    .shortcut-badge {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        background: rgba(255, 255, 255, 0.1);
        padding: 2px 6px;
        border-radius: 4px;
        color: #cbd5e1;
    }

    .github-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 10px;
        padding: 8px 14px;
        color: #f8fafc;
        font-size: 0.85rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }
    .github-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.25);
    }

    .mobile-toggle {
        display: none;
        background: none;
        border: none;
        color: #ffffff;
        font-size: 1.5rem;
        cursor: pointer;
    }

    @media (max-width: 768px) {
        .nav-menu {
            display: none;
        }
        .mobile-toggle {
            display: block;
        }
    }

    /* Search Modal Overlay */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(10px);
        z-index: 1000;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 100px;
    }
    .search-dialog {
        background: #11141d;
        border: 1px solid rgba(0, 242, 254, 0.3);
        border-radius: 16px;
        width: 90%;
        max-width: 600px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
        overflow: hidden;
    }
    .search-input-header {
        display: flex;
        align-items: center;
        padding: 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .search-input-field {
        width: 100%;
        background: transparent;
        border: none;
        outline: none;
        color: #ffffff;
        font-size: 1.1rem;
        padding: 0 12px;
        font-family: var(--font-sans);
    }
    .search-results-list {
        max-height: 350px;
        overflow-y: auto;
        padding: 12px;
    }
    .search-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px;
        border-radius: 8px;
        color: #cbd5e1;
        cursor: pointer;
        transition: background 0.2s ease;
    }
    .search-item:hover {
        background: rgba(0, 242, 254, 0.1);
        color: #00f2fe;
    }
</style>

<header class="header-nav">
    <div class="nav-container">
        <Link to="/" class="brand-logo">
            <img src="/eronom_logo.png" alt="Eronom Logo" class="brand-logo-img" />
            <span>Eronom</span>
            <span class="version-pill">v0.9.2</span>
        </Link>

        <ul class="nav-menu">
            <li><Link to="/docs" class="nav-link">Docs</Link></li>
            <li><Link to="/api" class="nav-link">API Reference</Link></li>
            <li><Link to="/guides" class="nav-link">Guides</Link></li>
            <li><Link to="/benchmarks" class="nav-link">Benchmarks</Link></li>
        </ul>

        <div style="display: flex; align-items: center; gap: 12px;">
            <button class="search-btn" onClick={openSearch}>
                <span>🔍 Search documentation...</span>
                <span class="shortcut-badge">⌘K</span>
            </button>

            <a href="https://github.com" target="_blank" class="github-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
                <span>1</span>
            </a>

            <button class="mobile-toggle" onClick={toggleMobileMenu}>
                ☰
            </button>
        </div>
    </div>
</header>

if isSearchOpen {
    <div class="modal-overlay" id="search-modal" onClick={(e) => { if(e.target.className === 'modal-overlay') closeSearch(); }}>
        <div class="search-dialog">
            <div class="search-input-header">
                <span>🔍</span>
                <input 
                    id="global-search-input"
                    class="search-input-field" 
                    placeholder="Search docs, APIs, signals, guides..." 
                    value={searchQuery}
                    onInput={(e) => { searchQuery = e.target.value; }}
                />
                <button style="background: none; border: none; color: #64748b; cursor: pointer; font-size: 1rem;" onClick={closeSearch}>✕</button>
            </div>
            <div class="search-results-list">
                <Link to="/docs" class="search-item" onClick={closeSearch}>
                    <div>
                        <strong>Getting Started Quickstart</strong>
                        <div style="font-size: 0.8rem; color: #64748b;">Installation, eronom init, running dev server</div>
                    </div>
                    <span>→</span>
                </Link>
                <Link to="/docs" class="search-item" onClick={closeSearch}>
                    <div>
                        <strong>Reactive Signals (useState)</strong>
                        <div style="font-size: 0.8rem; color: #64748b;">Fine-grained reactivity without Virtual DOM</div>
                    </div>
                    <span>→</span>
                </Link>
                <Link to="/api" class="search-item" onClick={closeSearch}>
                    <div>
                        <strong>Server API Routes</strong>
                        <div style="font-size: 0.8rem; color: #64748b;">server/api/routes.er configuration</div>
                    </div>
                    <span>→</span>
                </Link>
                <Link to="/benchmarks" class="search-item" onClick={closeSearch}>
                    <div>
                        <strong>Performance Benchmarks</strong>
                        <div style="font-size: 0.8rem; color: #64748b;">Eronom vs Next.js vs Nuxt vs Bun speed</div>
                    </div>
                    <span>→</span>
                </Link>
            </div>
        </div>
    </div>
}
